# Server-only analytics persistence. Never expose these as NEXT_PUBLIC_*.
# Keep disabled until the dedicated schema and edge rate limit are applied and verified.
ANALYTICS_SUPABASE_ENABLED=false
ANALYTICS_SUPABASE_URL=https://your-project.supabase.co
ANALYTICS_SUPABASE_SERVICE_ROLE_KEY=replace-with-a-dedicated-server-secret

# Visitor concierge. Empty values fail closed; no fake assistant response.
# Set only in server custody, never NEXT_PUBLIC_* and never commit real values.
# Keep Next and Hermes bound to loopback behind the trusted ingress.
HERMES_CONCIERGE_URL=http://127.0.0.1:8658/v1/chat/completions
HERMES_CONCIERGE_KEY=
HERMES_CONCIERGE_ORIGIN=https://je4ndev.com
HERMES_CONCIERGE_PROXY_KEY=
HERMES_CONCIERGE_SALT=
# Absolute durable directory OUTSIDE public/ and source, owned by the app user.
HERMES_CONCIERGE_STATE_DIR=
# Required on public production origins. Sitekey is public; secret stays server-only.
HERMES_CONCIERGE_TURNSTILE_REQUIRED=1
HERMES_CONCIERGE_TURNSTILE_SITE_KEY=
HERMES_CONCIERGE_TURNSTILE_SECRET_KEY=
# Official dummy keys are accepted ONLY for loopback review, never public production.
HERMES_CONCIERGE_TURNSTILE_TEST_MODE=0
# Server-side effort only; browsers cannot choose it. Compare before selecting medium.
HERMES_CONCIERGE_REASONING_EFFORT=medium
# Name + WhatsApp registration precedes model use. Memory remains a separate opt-in.
HERMES_CONCIERGE_REQUIRE_REGISTRATION=1

# Private Google Sheets relay. Leave blank until the owner deploys integrations/nora-sheets/Code.gs.
PORTFOLIO_LEADS_SHEETS_WEBHOOK_URL=
# Absolute path outside the checkout; never commit this shared secret.
PORTFOLIO_LEADS_SHEETS_SECRET_FILE=
# Ingress MUST strip/overwrite X-Concierge-Proxy and X-Real-IP.
# Read docs/nora-self-hosting.md before any public enablement.
